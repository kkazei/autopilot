OPENROUTER_API_KEY=
OPENROUTER_MODELS=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
AUTOPILOT_WRITER_RUNTIME=direct

# Hosted setup (docs/WEB_APP_PLAN.md). The Neon direct (non-pooled) URL: scripts.db_run, db_import and the backend use it.
DATABASE_URL=
# Shared with Render and Vercel; the web app sends it to the backend. Make one: python -c "import secrets; print(secrets.token_hex(32))"
AUTOPILOT_BACKEND_SECRET=
# Optional: a separate Neon branch for tests/test_db_store_live.py, which drops tables. It refuses to run against DATABASE_URL.
AUTOPILOT_TEST_DATABASE_URL=
